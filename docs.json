{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Huny API Platform",
  "colors": {
    "primary": "#6D28D9",
    "light": "#9E7BFF",
    "dark": "#4C1D95"
  },
  "favicon": "/images/checks-passed.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Integration",
            "pages": [
              "development",
              "essentials/markdown",
              "essentials/code"
            ]
          },
          {
            "group": "Operations",
            "pages": [
              "essentials/images",
              "essentials/navigation",
              "essentials/settings",
              "essentials/reusable-snippets"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Core resources",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete"
            ]
          },
          {
            "group": "Automation",
            "pages": [
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Docs",
          "href": "https://docs.huny.dev",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://blog.huny.dev",
          "icon": "newspaper"
        },
        {
          "anchor": "Status",
          "href": "https://status.huny.dev",
          "icon": "wifi"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/hero-light.png",
    "dark": "/images/hero-dark.png",
    "href": "https://docs.huny.dev"
  },
  "navbar": {
    "links": [
    {
      "label": "Status",
      "href": "https://status.huny.dev"
    },
    {
      "label": "Support",
      "href": "mailto:support@huny.dev"
    }
    ],
    "primary": {
      "type": "button",
    "label": "Get API Key",
    "href": "https://dashboard.huny.dev"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "api": {
    "baseUrl": "https://api.huny.dev/v1",
    "auth": {
      "method": "bearer",
      "name": "Huny API Key",
      "inputPrefix": "hun_live_"
    },
    "playground": {
      "mode": "show"
    }
  },
  "openapi": "/api-reference/openapi.json",
  "footer": {
    "socials": {
      "x": "https://x.com/hunyapi",
      "github": "https://github.com/huny-labs",
      "linkedin": "https://www.linkedin.com/company/huny"
    }
  }
}
