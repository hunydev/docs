{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Huny API",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "api": {
    "baseUrl": "https://api.huny.dev/v1",
    "auth": {
      "method": "bearer"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "시작하기",
        "groups": [
          {
            "group": "소개",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "인증",
            "pages": [
              "api-reference/authentication"
            ]
          },
          {
            "group": "가이드",
            "pages": [
              "guides/rate-limits",
              "guides/error-handling",
              "guides/webhooks",
              "guides/best-practices"
            ]
          }
        ]
      },
      {
        "tab": "API 레퍼런스",
        "groups": [
          {
            "group": "개요",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "사용자",
            "pages": [
              "api-reference/endpoint/users/get",
              "api-reference/endpoint/users/create",
              "api-reference/endpoint/users/update",
              "api-reference/endpoint/users/delete"
            ]
          },
          {
            "group": "리소스",
            "pages": [
              "api-reference/endpoint/resources/get",
              "api-reference/endpoint/resources/create",
              "api-reference/endpoint/resources/update",
              "api-reference/endpoint/resources/delete"
            ]
          },
          {
            "group": "웹훅",
            "pages": [
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "문서",
          "href": "https://docs.huny.dev",
          "icon": "book-open-cover"
        },
        {
          "anchor": "블로그",
          "href": "https://blog.huny.dev",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "지원",
        "href": "mailto:support@huny.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "대시보드",
      "href": "https://api.huny.dev/dashboard"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/hunydev",
      "github": "https://github.com/hunydev",
      "linkedin": "https://linkedin.com/company/hunydev"
    }
  }
}
