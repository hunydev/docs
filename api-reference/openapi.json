            "example": null
          },
          "next": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "description": "다음 페이지 URL",
            "example": "https://api.huny.dev/v1/users?page=2"
          }
        }
      },
      "UserWebhookEvent": {
        "type": "object",
